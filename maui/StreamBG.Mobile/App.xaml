<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:StreamBG.Mobile.Converters"
             x:Class="StreamBG.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <conv:TabBgConverter          x:Key="TabBgConverter"/>
            <conv:EqualConverter          x:Key="EqualConverter"/>
            <conv:InitialConverter        x:Key="InitialConverter"/>
            <conv:NotNullConverter        x:Key="NotNullConverter"/>
            <conv:BoolToStringConverter   x:Key="BoolToStringConverter"/>
            <conv:InvertBoolConverter     x:Key="InvertBoolConverter"/>
            <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
            <conv:SecondsToTimeConverter  x:Key="SecondsToTimeConverter"/>
            <conv:ClipReadyConverter      x:Key="ClipReadyConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
