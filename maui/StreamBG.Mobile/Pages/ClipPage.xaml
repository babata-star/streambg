<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreamBG.Mobile.ViewModels"
             xmlns:m="clr-namespace:StreamBG.Mobile.Models"
             x:Class="StreamBG.Mobile.Pages.ClipPage"
             x:DataType="vm:ClipViewModel"
             BackgroundColor="#0e0e10"
             Title="">

    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="4,0">
            <Border BackgroundColor="#a970ff" StrokeShape="RoundRectangle 6" Padding="6,4">
                <Label Text="✂" TextColor="White" FontSize="14" FontAttributes="Bold"/>
            </Border>
            <Label Text="Клипове" TextColor="#efeff1" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!-- Sort chips -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="14,10">
            <!-- Нови -->
            <Border x:Name="ChipNewest" Padding="12,6" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSort}" Value="newest">
                        <Setter Property="BackgroundColor" Value="#a970ff"/>
                        <Setter Property="Stroke"          Value="#a970ff"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSort}" Value="popular">
                        <Setter Property="BackgroundColor" Value="#18181b"/>
                        <Setter Property="Stroke"          Value="#26262c"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="🕐 Нови" TextColor="#efeff1" FontSize="13">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeSortCommand}" CommandParameter="newest"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>

            <!-- Популярни -->
            <Border x:Name="ChipPopular" Padding="12,6" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSort}" Value="popular">
                        <Setter Property="BackgroundColor" Value="#a970ff"/>
                        <Setter Property="Stroke"          Value="#a970ff"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding SelectedSort}" Value="newest">
                        <Setter Property="BackgroundColor" Value="#18181b"/>
                        <Setter Property="Stroke"          Value="#26262c"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="🔥 Популярни" TextColor="#efeff1" FontSize="13">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangeSortCommand}" CommandParameter="popular"/>
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </HorizontalStackLayout>

        <!-- Loading overlay -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#a970ff"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="0,20"/>

        <!-- Clip grid -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#a970ff">
            <CollectionView ItemsSource="{Binding Clips}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Clip">
                        <Border BackgroundColor="#18181b" StrokeShape="RoundRectangle 10"
                                Stroke="#26262c" StrokeThickness="1" Margin="4,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClipViewModel}}, Path=OpenClipCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="140,Auto">

                                <!-- Thumbnail -->
                                <Grid Grid.Row="0">
                                    <!-- Placeholder (no thumbnail) -->
                                    <Border BackgroundColor="#26262c" StrokeShape="RoundRectangle 10,10,0,0">
                                        <Label Text="{Binding StreamerUsername, Converter={StaticResource InitialConverter}}"
                                               TextColor="#5a5a6a" FontSize="32" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Actual thumbnail when available -->
                                    <Image Source="{Binding ThumbnailUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding ThumbnailUrl, Converter={StaticResource NotNullConverter}}"
                                           Clip="RoundRectangleGeometry Rect='0,0,1,1'"/>

                                    <!-- Duration badge (bottom-right) -->
                                    <Border BackgroundColor="#88000000" StrokeShape="RoundRectangle 4"
                                            Padding="5,2" HorizontalOptions="End" VerticalOptions="End" Margin="4">
                                        <Label Text="{Binding DurationSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                                               TextColor="White" FontSize="11"/>
                                    </Border>

                                    <!-- Processing overlay (shown when clip is NOT Ready) -->
                                    <Border BackgroundColor="#AA000000"
                                            IsVisible="{Binding Status, Converter={StaticResource ClipReadyConverter}, ConverterParameter=invert}">
                                        <Label Text="⏳ Обработва се..." TextColor="#adadb8" FontSize="12"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Row="1" Padding="8" Spacing="4">
                                    <Label Text="{Binding Title}" TextColor="#efeff1"
                                           FontSize="13" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="2"/>
                                    <Label Text="{Binding StreamerUsername}" TextColor="#a970ff"
                                           FontSize="11"/>
                                    <Label Text="{Binding ViewCount, StringFormat='{0:N0} гледания'}"
                                           TextColor="#5a5a6a" FontSize="11"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Empty state -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                        Spacing="12" Margin="0,60">
                        <Label Text="✂" FontSize="48" HorizontalOptions="Center" TextColor="#26262c"/>
                        <Label Text="Все още няма клипове" TextColor="#5a5a6a"
                               FontSize="15" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
