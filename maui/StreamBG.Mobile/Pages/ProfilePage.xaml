<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreamBG.Mobile.ViewModels"
             x:Class="StreamBG.Mobile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#0e0e10"
             Title="Профил">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Not logged in -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="16" Padding="40,80"
                                 IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertBoolConverter}}">
                <Label Text="👤" FontSize="56" HorizontalOptions="Center"/>
                <Label Text="Не си влязъл" TextColor="#efeff1" FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="Влез в профила си, за да видиш настройките" TextColor="#adadb8"
                       FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Button Text="Вход / Регистрация"
                        BackgroundColor="#a970ff" TextColor="White"
                        FontSize="15" FontAttributes="Bold"
                        CornerRadius="10" HeightRequest="48"
                        Command="{Binding LogoutCommand}"/>
            </VerticalStackLayout>

            <!-- Logged in -->
            <VerticalStackLayout IsVisible="{Binding IsLoggedIn}" Spacing="0">

                <!-- Profile header -->
                <VerticalStackLayout BackgroundColor="#18181b" Padding="20,24" Spacing="12"
                                     HorizontalOptions="Fill">
                    <Border BackgroundColor="#a970ff" StrokeShape="RoundRectangle 999"
                            WidthRequest="72" HeightRequest="72" HorizontalOptions="Center">
                        <Label Text="{Binding Username, Converter={StaticResource InitialConverter}}"
                               TextColor="White" FontSize="28" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{Binding Username}" TextColor="#efeff1"
                           FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Border BackgroundColor="#33a970ff" StrokeShape="RoundRectangle 999"
                            Padding="12,4" HorizontalOptions="Center"
                            IsVisible="{Binding IsStreamer}">
                        <Label Text="🎥 Стриймър" TextColor="#a970ff" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>

                <BoxView HeightRequest="8" BackgroundColor="#0e0e10"/>

                <!-- Stream key section (streamer only) -->
                <VerticalStackLayout BackgroundColor="#18181b" Padding="16" Spacing="12"
                                     IsVisible="{Binding IsStreamer}">
                    <Label Text="СТРИЙМ КЛЮЧ" TextColor="#5a5a6a" FontSize="11" FontAttributes="Bold"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#a970ff"
                                       IsVisible="{Binding IsLoading}" HorizontalOptions="Start"/>

                    <Border BackgroundColor="#26262c" Stroke="#3a3a44" StrokeShape="RoundRectangle 8"
                            Padding="12,10"
                            IsVisible="{Binding StreamKey, Converter={StaticResource NotNullConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding StreamKey}"
                                   TextColor="#efeff1" FontSize="12" FontFamily="monospace"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="#a970ff"
                                    StrokeShape="RoundRectangle 6" Padding="10,6">
                                <Label Text="Копирай" TextColor="White" FontSize="11" FontAttributes="Bold">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LoadCommand}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>

                    <Label Text="Стрийм URL: rtmp://твоят-сървър:1935/live"
                           TextColor="#5a5a6a" FontSize="11"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="8" BackgroundColor="#0e0e10"
                         IsVisible="{Binding IsStreamer}"/>

                <!-- Stream settings (streamer only) -->
                <VerticalStackLayout BackgroundColor="#18181b" Padding="16" Spacing="12"
                                     IsVisible="{Binding IsStreamer}">
                    <Label Text="НАСТРОЙКИ НА СТРИЙМА" TextColor="#5a5a6a"
                           FontSize="11" FontAttributes="Bold"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Заглавие" TextColor="#adadb8" FontSize="12"/>
                        <Border BackgroundColor="#26262c" Stroke="#3a3a44" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding StreamTitle}"
                                   Placeholder="Заглавие на стрийма..."
                                   PlaceholderColor="#5a5a6a" TextColor="#efeff1"
                                   BackgroundColor="Transparent" Margin="12,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Описание" TextColor="#adadb8" FontSize="12"/>
                        <Border BackgroundColor="#26262c" Stroke="#3a3a44" StrokeShape="RoundRectangle 8">
                            <Editor Text="{Binding StreamDescription}"
                                    Placeholder="Описание (незадължително)..."
                                    PlaceholderColor="#5a5a6a" TextColor="#efeff1"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="80"
                                    Margin="12,8"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Категория" TextColor="#adadb8" FontSize="12"/>
                        <Border BackgroundColor="#26262c" Stroke="#3a3a44" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding StreamCategory}"
                                   Placeholder="Игри, Музика, Спорт..."
                                   PlaceholderColor="#5a5a6a" TextColor="#efeff1"
                                   BackgroundColor="Transparent" Margin="12,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Status message -->
                    <Label Text="{Binding StatusMessage}" TextColor="#a970ff" FontSize="13"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource NotNullConverter}}"/>

                    <Button Text="Запази настройките"
                            BackgroundColor="#a970ff" TextColor="White"
                            FontSize="14" FontAttributes="Bold"
                            CornerRadius="8" HeightRequest="46"
                            Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="8" BackgroundColor="#0e0e10"/>

                <!-- Logout -->
                <VerticalStackLayout BackgroundColor="#18181b" Padding="16" Spacing="0">
                    <Button Text="Изход"
                            BackgroundColor="Transparent"
                            TextColor="#f87171"
                            FontSize="15" FontAttributes="Bold"
                            BorderColor="#33f87171" BorderWidth="1"
                            CornerRadius="8" HeightRequest="46"
                            Command="{Binding LogoutCommand}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
