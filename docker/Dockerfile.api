# ─── Build stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["src/StreamBG.API/StreamBG.API.csproj",           "StreamBG.API/"]
COPY ["src/StreamBG.Core/StreamBG.Core.csproj",         "StreamBG.Core/"]
COPY ["src/StreamBG.Infrastructure/StreamBG.Infrastructure.csproj", "StreamBG.Infrastructure/"]

RUN dotnet restore "StreamBG.API/StreamBG.API.csproj"

COPY src/ .
RUN dotnet publish "StreamBG.API/StreamBG.API.csproj" -c Release -o /app/publish

# ─── Runtime stage ───────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

# FFmpeg за social relay
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

EXPOSE 5000
ENTRYPOINT ["dotnet", "StreamBG.API.dll"]
